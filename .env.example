# Environment variables for AWS Django Blog
# ================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control - it contains secrets.

# ============ Security ============
# Django SECRET_KEY - required for Django security
# Generate with: python -c "import django; print(django.utils.cryptographic.get_random_key())"
# or: openssl rand -hex 50
SECRET_KEY=django-insecure-change-me-to-a-secure-random-key-in-production

# DEBUG mode - False in production for security
# When True, Django shows detailed error pages (development only)
DEBUG=False

# Allowed hosts - comma-separated list of valid hostnames
# Required for Django's Host header and CSRF validation in production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CSRF trusted origins - comma-separated list of origins trusted for CSRF
# Add your domain(s) here for production CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost,https://localhost

# ============ Database ============
# Database configuration - SQLite by default, RDS when DB_* vars are set
# DB_ENGINE: django.db.backends.sqlite3 or django.db.backends.mysql etc.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ============ Amazon Bedrock AI Settings ============
# AWS region for Bedrock service
AWS_REGION=us-east-1

# Bedrock model ID - which foundation model to use
# Options include: anthropic.claude-3-haiku-20240307-v1:0, anthropic.claude-3-sonnet-20240229-v1:0, etc.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AI Mock Mode - when True, uses offline mock generator instead of Bedrock
# Set to False to use real Bedrock AI suggestions (requires AWS credentials)
AI_MOCK_MODE=True