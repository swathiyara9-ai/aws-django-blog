# Django Core Settings
# In production, generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-secret-key-do-not-commit-secrets

# DEBUG must be False in production! Default is False if omitted.
DEBUG=False

# Comma-separated list of hostnames/IPs this app can serve (e.g. ALB DNS, domain, or localhost)
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF protection (e.g. http://127.0.0.1:8000, https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration (Leave unset for local development with SQLite; populate for AWS RDS)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=blogdb
# DB_USER=bloguser
# DB_PASSWORD=your_secure_password
# DB_HOST=your-rds-endpoint.amazonaws.com
# DB_PORT=5432

# Amazon Bedrock AI Settings
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Set to 'false' to invoke real Amazon Bedrock; set to 'true' for offline mock testing
AI_MOCK_MODE=true

# Amazon S3 Media Storage (Leave unset for local development with local media/ storage)
# In production on AWS EC2, credentials are automatically provided by the EC2 IAM Role.
# AWS_STORAGE_BUCKET_NAME=your-s3-media-bucket-name
# AWS_S3_REGION_NAME=ap-southeast-2

